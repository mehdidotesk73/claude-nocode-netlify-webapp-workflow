{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    // A composite project can't set noEmit, so send its output somewhere
    // ignored instead — otherwise every build drops a stray vite.config.js
    // and vite.config.d.ts next to the source.
    "outDir": "./node_modules/.tmp/tsconfig-node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig-node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
